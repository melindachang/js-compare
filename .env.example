# PostgreSQL Connection Configuration
# Password will be read automatically from ~/.pgpass if PGPASSWORD is left unset.
# Format in ~/.pgpass: hostname:port:database:username:password (permissions: chmod 0600 ~/.pgpass)
PGHOST=localhost
PGPORT=5432
PGDATABASE=telegram
PGUSER=postgres
# PGPASSWORD=
# PGPASSFILE=~/.pgpass

# CST & Tree Extraction Settings
# Categories: 'all', 'loose' (Programs, Functions, Declarations, Statements),
# or a comma-separated list of types.
NODE_TYPES=all

# Minimum subtree node count to persist in telegram.file_subtrees
# 1 = record every AST node; 5 or 10 = index only substantial code structures (reduces DB storage significantly)
MIN_WEIGHT=1

# Performance & Batching
BATCH_SIZE=500
NUM_WORKERS=4
