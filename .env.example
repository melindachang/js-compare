PGHOST=
PGPORT=
PGDATABASE=
PGUSER=
# PGPASSWORD=
# PGPASSFILE=~/.pgpass

# CST & Tree Extraction Settings
NODE_TYPES=all

# Minimum subtree node count to persist in telegram.file_subtrees
# 5 or 10 = index substantial structures (functions, blocks, statements) and avoids leaf noise (identifiers)
MIN_WEIGHT=5

BATCH_SIZE=500
NUM_WORKERS=4
